        "type": "function",
        "z": "ccc74c6b12c1e477",
        "name": "function 5",
        "func": "let entrada = msg.payload;\n\nlet limpio = String(entrada).replace(/[^\\d.-]/g, '').trim();\nlet valorFinal = parseFloat(limpio);\n\nif (isNaN(valorFinal) || valorFinal <= 0) return null;\n\n// 🔥 evitar repetir el mismo valor\nlet ultimo = flow.get(\"ultimo\") || null;\n\nif (valorFinal === ultimo) {\n    return null; // no enviar duplicados\n}\n\nflow.set(\"ultimo\", valorFinal);\n\nmsg.params = [valorFinal];\n\nreturn msg;",
