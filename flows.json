        "format": "<style>\n    .nr-dashboard-template { padding: 0 !important; margin: 0 !important; overflow: visible !important; }\n    .card-marco {\n        position: absolute; top: 6px; left: 6px; right: 6px; bottom: 6px;\n        background-color: white; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n        display: flex; align-items: center; padding: 15px; overflow: hidden;\n    }\n    @keyframes drop_water {\n        0% { transform: translateY(-10px); opacity: 0; }\n        50% { opacity: 1; }\n        100% { transform: translateY(15px); opacity: 0; }\n    }\n</style>\n<div class=\"card-marco\">\n    <div style=\"flex: 1; text-align: center; position: relative; height: 100%; display: flex; justify-content: center; align-items: center;\">\n        <i class=\"fa fa-tint fa-2x\" style=\"color: #3498db; position: absolute; margin-left: -15px; animation: drop_water 1.5s infinite ease-in;\"></i>\n        <i class=\"fa fa-tint fa-lg\" style=\"color: #85c1e9; position: absolute; margin-left: 10px; animation: drop_water 2s infinite ease-in 0.5s;\"></i>\n    </div>\n    <div style=\"flex: 2; padding-left: 15px; border-left: 1px solid #eee; display: flex; flex-direction: column; justify-content: center;\">\n        <div style=\"font-size: 1em; color: #666; font-weight: bold;\">Volumen de Agua</div>\n        <div style=\"font-size: 2em; font-weight: bold; line-height: 1.1;\"\n            ng-style=\"{'color': (msg.payload.toString().includes('100')) ? '#e74c3c' : '#1a5276'}\">\n            {{msg.payload}}\n        </div>\n    </div>\n</div>",
