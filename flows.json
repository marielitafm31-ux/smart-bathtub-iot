        "format": "<style>\n    .nr-dashboard-template { padding: 0 !important; margin: 0 !important; overflow: visible !important; }\n    .card-marco {\n        position: absolute; top: 6px; left: 6px; right: 6px; bottom: 6px;\n        background-color: white; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n        display: flex; align-items: center; padding: 15px; overflow: hidden;\n        border-left: 6px solid {{ (msg.payload == 1) ? '#ff0055' : '#bdc3c7' }};\n    }\n    @keyframes soap_drop {\n        0% { transform: translateY(-30px) scale(0.8); opacity: 0; }\n        50% { opacity: 1; }\n        100% { transform: translateY(40px) scale(1.1); opacity: 0; }\n    }\n</style>\n<div class=\"card-marco\" ng-style=\"{'background-color': (msg.payload == 1) ? '#f8f9ff' : 'white'}\">\n    <div style=\"flex: 1; text-align: center; display: flex; justify-content: center; align-items: center;\">\n        <i ng-if=\"msg.payload == 1\" class=\"fa fa-circle\" style=\"font-size: 2.5em; color: #ff0055; animation: soap_drop 1.5s infinite linear;\"></i>\n        <i ng-if=\"msg.payload != 1\" class=\"fa fa-circle-thin\" style=\"font-size: 2.5em; color: #eee;\"></i>\n    </div>\n    <div style=\"flex: 2; padding-left: 15px; display: flex; flex-direction: column; justify-content: center;\">\n        <div style=\"font-size: 0.9em; color: #7f8c8d; font-weight: bold; text-transform: uppercase;\">Dispensador</div>\n        <div style=\"font-size: 1.5em; font-weight: 900;\" ng-style=\"{'color': (msg.payload == 1) ? '#2c3e50' : '#bdc3c7'}\">\n            {{(msg.payload == 1) ? 'JABÓN CAYENDO' : 'EN ESPERA'}}\n        </div>\n    </div>\n</div>",
