    {
        "id": "b83b7d510ad04f3d",
        "type": "function",
        "z": "ccc74c6b12c1e477",
        "name": "function 3",
        "func": "// 1. Recuperamos la memoria\nlet puerta = context.get('puerta') || \"CERRADA\";\nlet presencia = context.get('presencia') || \"0\";\n\n// 2. Normalizamos la entrada (De texto a valor útil)\nlet datoRecibido = msg.payload.toString().trim();\n\nif (msg.topic && msg.topic.includes(\"puerta\")) {\n    puerta = (datoRecibido === \"ABIERTA\") ? \"ABIERTA\" : \"CERRADA\";\n    context.set('puerta', puerta);\n} \n\nif (msg.topic && msg.topic.includes(\"presencia\")) {\n    // Si llega \"1\", \"true\" o \"Detectado\", lo guardamos como \"1\"\n    presencia = (datoRecibido === \"1\" || datoRecibido === \"Detectado\" || datoRecibido === \"true\") ? \"1\" : \"0\";\n    context.set('presencia', presencia);\n}\n\n// 3. Lógica de Seguridad (Reforzada)\nlet luz = (presencia === \"1\" || puerta === \"ABIERTA\");\nlet alertaMsg = (presencia === \"1\") ? \"Presencia en Bañera\" : \"Bañera vacía\";\n\n// 4. Salidas\nreturn [\n    { payload: alertaMsg }, \n    { payload: luz }, // Esto enviará un booleano real al switch\n    { payload: puerta }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 220,
        "wires": [
