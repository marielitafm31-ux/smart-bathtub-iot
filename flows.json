    {
        "id": "ca44f02217b7ba0c",
        "type": "function",
        "z": "ccc74c6b12c1e477",
        "name": "Select topic",
        "func": "// Validamos que el mensaje traiga un tópico\nif (!msg.topic) return null;\n\n// IMPORTANTE: Todas las salidas deben tener 6 posiciones [1,2,3,4,5,6]\nif (msg.topic.includes(\"door\")) {\n    return [msg, null, null, null, null, null]; // Salida 1\n} else if (msg.topic.includes(\"light\")) {\n    return [null, msg, null, null, null, null]; // Salida 2\n} else if (msg.topic.includes(\"temperature\")) {\n    return [null, null, msg, null, null, null]; // Salida 3\n} else if (msg.topic.includes(\"presencia\")) {\n    return [null, null, null, msg, null, null]; // Salida 4\n} else if (msg.topic.includes(\"volume\")) {\n    return [null, null, null, null, msg, null]; // Salida 5\n} else if (msg.topic.includes(\"caidaJabon\")) {\n    return [null, null, null, null, null, msg]; // Salida 6 -> ¡ESTA ES LA TUYA!\n}\n\nreturn null;",
        "outputs": 6,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
