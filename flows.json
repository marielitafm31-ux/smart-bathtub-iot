        "type": "ui_template",
        "z": "ccc74c6b12c1e477",
        "group": "cb4d5998ba74a535",
        "name": "Presencia",
        "order": 0,
        "width": "6",
        "height": "3",
        "format": "<style>\n    .nr-dashboard-template { padding: 0 !important; margin: 0 !important; overflow: visible !important; }\n    .card-marco {\n        position: absolute; top: 6px; left: 6px; right: 6px; bottom: 6px;\n        background-color: white; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n        display: flex; align-items: center; padding: 15px; transition: all 0.5s ease;\n    }\n    @keyframes pulse_presence {\n        0% { transform: scale(1); opacity: 1; }\n        50% { transform: scale(1.1); opacity: 0.7; }\n        100% { transform: scale(1); opacity: 1; }\n    }\n</style>\n<div class=\"card-marco\" ng-style=\"{'background-color': (msg.payload == 1) ? '#f0f9ff' : 'white'}\">\n    <div style=\"flex: 1; text-align: center;\">\n        <i ng-if=\"msg.payload == 1\" class=\"fa fa-user fa-3x\" style=\"color: #2980b9; animation: pulse_presence 2s infinite;\"></i>\n        <i ng-if=\"msg.payload == 0\" class=\"fa fa-user-times fa-3x\" style=\"color: #bdc3c7;\"></i>\n    </div>\n    <div style=\"flex: 2; padding-left: 15px; border-left: 1px solid #eee; display: flex; flex-direction: column; justify-content: center;\">\n        <div style=\"font-size: 0.85em; color: #e74c3c; font-weight: bold; text-transform: uppercase;\">Presencia</div>\n        <div style=\"font-size: 1.6em; font-weight: bold; color: #333;\">\n            {{ (msg.payload == 1) ? 'Detectado' : 'Zona Vacía' }}\n        </div>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 740,
        "y": 280,
        "wires": [
            []
        ]
    },
