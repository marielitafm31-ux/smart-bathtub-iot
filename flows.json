        "func": "// Si la base de datos devuelve algo, lo pasamos. \n// Si viene vacía, mandamos un aviso al debug.\n//if (msg.payload.length === 0) {\n// La base de datos devuelve una lista en msg.payload\n// Si el mensaje es una lista (viene de la base de datos)\nif (Array.isArray(msg.payload)) {\n    msg.payload.forEach(function(fila) {\n        node.send({\n            topic: fila.color,\n            payload: fila.valor,\n            timestamp: new Date(fila.fecha).getTime()\n        });\n    });\n} \n// Si el mensaje es un número suelto (tiempo real)\nelse {\n    return {\n        topic: \"Bañera\",\n        payload: parseFloat(msg.payload),\n        timestamp: new Date().getTime()\n    };\n}\nreturn null;",
